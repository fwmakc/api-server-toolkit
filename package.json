{
  "name": "api-server-toolkit",
  "version": "0.14.0",
  "description": "NestJS CRUD engine, decorators, and guards for API microservices",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:fwmakc/api-server-toolkit"
  },
  "keywords": [
    "nestjs",
    "typeorm",
    "crud",
    "rest-api",
    "swagger",
    "guards",
    "decorators",
    "microservices",
    "access-control",
    "entity-controller"
  ],
  "bugs": {
    "url": "https://github.com/fwmakc/api-server-toolkit/issues"
  },
  "homepage": "https://github.com/fwmakc/api-server-toolkit#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./guard": {
      "types": "./dist/guard.d.ts",
      "default": "./dist/guard.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./helper": {
      "types": "./dist/helper.d.ts",
      "default": "./dist/helper.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "default": "./dist/health.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    },
    "./bootstrap/setup": {
      "types": "./dist/bootstrap/setup/index.d.ts",
      "default": "./dist/bootstrap/setup/index.js"
    },
    "./auth-client": {
      "types": "./dist/common/auth-client/index.d.ts",
      "default": "./dist/common/auth-client/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "guard": [
        "dist/guard.d.ts"
      ],
      "client": [
        "dist/client.d.ts"
      ],
      "helper": [
        "dist/helper.d.ts"
      ],
      "health": [
        "dist/health.d.ts"
      ],
      "bootstrap": [
        "dist/bootstrap.d.ts"
      ],
      "bootstrap/setup": [
        "dist/bootstrap/setup/index.d.ts"
      ],
      "auth-client": [
        "dist/common/auth-client/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "ai-declarations.md",
    "scripts/generate-service-context.js"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "ai-declarations": "node scripts/generate-declarations.js"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/config": "^3.0.0 || ^4.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/passport": "^10.0.0 || ^11.0.0",
    "@nestjs/platform-express": "^10.0.0 || ^11.0.0",
    "@nestjs/swagger": "^8.0.0 || ^11.0.0",
    "@nestjs/typeorm": "^10.0.0 || ^11.0.0",
    "@sentry/nestjs": "^9.0.0 || ^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "helmet": "^7.0.0 || ^8.0.0",
    "jwks-rsa": "^3.0.0",
    "passport-jwt": "^4.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20"
  },
  "peerDependenciesMeta": {
    "@sentry/nestjs": {
      "optional": true
    },
    "helmet": {
      "optional": true
    },
    "cookie-parser": {
      "optional": true
    },
    "jwks-rsa": {
      "optional": true
    },
    "passport-jwt": {
      "optional": true
    },
    "morgan": {
      "optional": true
    },
    "passport": {
      "optional": true
    },
    "redoc-express": {
      "optional": true
    },
    "typeorm-transactional": {
      "optional": true
    }
  },
  "dependencies": {
    "@supercharge/request-ip": "^1.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/nestjs": "^10.69.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "helmet": "^8.3.0",
    "jest": "^29.7.0",
    "jwks-rsa": "^4.1.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "ts-jest": "^29.4.12",
    "typeorm": "^0.3.31",
    "typescript": "^5.7.0"
  }
}
