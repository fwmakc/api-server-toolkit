{
  "name": "api-server-toolkit",
  "version": "2.0.0",
  "description": "NestJS CRUD engine, decorators, and guards for API microservices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./guard": {
      "types": "./dist/guard.d.ts",
      "default": "./dist/guard.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./helper": {
      "types": "./dist/helper.d.ts",
      "default": "./dist/helper.js"
    }
  },
  "typesVersions": {
    "*": {
      "guard": ["dist/guard.d.ts"],
      "client": ["dist/client.d.ts"],
      "helper": ["dist/helper.d.ts"]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "ai-declarations.md",
    "scripts/generate-service-context.js"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "ai-declarations": "node scripts/generate-declarations.js"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/config": "^3.0.0 || ^4.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/passport": "^10.0.0 || ^11.0.0",
    "@nestjs/platform-express": "^10.0.0 || ^11.0.0",
    "@nestjs/swagger": "^8.0.0 || ^11.0.0",
    "@nestjs/typeorm": "^10.0.0 || ^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20"
  },
  "dependencies": {
    "@supercharge/request-ip": "^1.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.31",
    "typescript": "^5.7.0"
  }
}
